TEXT 816 -72 Left 2 !.meas tran Vout_avg AVG V(VOUT) FROM 600u TO 800u\n.meas tran Vout_pp PP V(VOUT) FROM 600u TO 800u\n.meas tran IL_avg AVG I(L1) FROM 600u TO 800u\n.meas tran IL_ripple PP I(L1) FROM 600u TO 800u
TEXT 512 504 Left 2 !.meas tran Tsw TRIG V(VSWITCH) VAL=2.5 RISE=1 TD=600u TARG V(VSWITCH) VAL=2.5 RISE=2 TD=600u\n.meas tran Fsw PARAM 1/Tsw
TEXT 816 72 Left 2 !.meas TRAN Vin_avg  AVG V(VIN) FROM 600u TO 800u\n.meas TRAN Iin_avg  AVG -I(VIN1) FROM 600u TO 800u
TEXT 808 160 Left 2 !; Average input power delivered by the source\n.meas TRAN Pin_avg AVG (-V(VIN)*I(VIN1)) FROM=600u TO=800u\n \n; Average output power delivered to the 40-ohm load\n.meas TRAN Pout_avg AVG (V(VOUT)*V(VOUT)/{RL}) FROM=600u TO=800u\n \n; Average power loss in the converter\n.meas TRAN Ploss PARAM Pin_avg-Pout_avg\n \n; Power conversion efficiency in percentage\n.meas TRAN Efficiency PARAM 100*Pout_avg/Pin_avg
