TEXT 928 -312 Left 2 !.param RL=40
TEXT -848 720 Left 2 !.meas TRAN Pgate AVG -(V(VSWITCH)-V(SW))*I(VSWITCH1) FROM= 4.8m TO= 5m\n.meas TRAN Pfet AVG (V(VIN)-V(SW))*Id(M1) FROM= 4.8m TO= 5m\n.meas TRAN Pdiode AVG -V(SW)*I(D1) FROM=4.8m TO= 5m\n   .meas TRAN Eff_total PARAM 100*Pout_avg/(Pin_avg+Pgate)
